# Node modules
node_modules

# Package Lock
package-lock.json

# Compiled releases
release

# Ignore electron-forge build output
out/

# Ignore webpack build output
.webpack/

# Ignore the build-configuration that is generated by electron-rebuild for macOS
# targets while bundling fsevents (config.gypi)
build/

# Ignore the custom user test config
test-config.yml

# Hidden files and stuff
/**/.DS_Store

# Don't commit these pesky yarn logs
yarn-error.log
yarn.log

# Don't commit ESLint stuff
eslint_report.htm
.eslintcache

# Taken from https://www.gitignore.io/api/visualstudiocode

### VisualStudioCode ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/zettlr.code-snippets

# Yarn-specific ignores (cf. https://yarnpkg.com/getting-started/qa#which-files-should-be-gitignored)
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

### VisualStudioCode Patch ###
# Ignore all local history of files
.history

### Idea ###
.idea/*

# Claude exploratory scripts
_Claude_tmp/

# User-provided screenshots (may contain personal desktop information)
User_Provided_Screenshots/

# ==== Missing standard entries added (standard template of Initialize_Project_Gitignore.py) ====

# Sensitive / private files, second line of defense (case-insensitive, any position)
*[Ss][Ee][Cc][Rr][Ee][Tt]*
*[Pp][Rr][Ii][Vv][Aa][Tt][Ee]*

# Broad exclusions: temporary / obsolete / to-do (any case, any position; force-add a wrongly matched file with git add -f)
*[Oo][Bb][Ss][Oo][Ll][Ee][Tt][Ee]*
*[Tt][Oo][Dd][Oo]*

# Local Claude collaboration instructions and project settings
CLAUDE.md

# Local Codex instruction files and settings
AGENTS.md
AGENTS.override.md
.codex/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
dist/

# Lint and test caches
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Environment variable files (keep API keys and the like out of the repository; .env.example is a key-free sample and is kept)
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Office lock files and backup / temporary suffixes
~$*
*.bak
*.tmp
*.swp
*~

# System files
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# Broad exclusions: temporary / obsolete / to-do (any case, any position; force-add a wrongly matched file with git add -f)
*[Tt][Ee][Mm][Pp]*
# Names containing "Template" are not temporary files: re-include them (must stay after the Temp pattern; cannot rescue a path whose parent directory is itself excluded)
!*[Tt][Ee][Mm][Pp][Ll][Aa][Tt][Ee]*

# Editors
.vscode/

# Policy of this branch (user ruling 2026-10-04): test files are not committed; tests already tracked upstream are unaffected
/test/

# ==== Test files kept out of version control by default (added to the standard template 2026-10-04) ====
# Test files: not reviewed as strictly as production code and their fixtures may leak private data, so excluded by default (force-add a wrongly matched file with git add -f)
*[Tt][Ee][Ss][Tt]*
